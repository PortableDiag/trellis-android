<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Runtime-requested on API 33+, and only when a notification toggle is
         turned on: asking at first launch for a feature that is off by default
         is how an app trains you to say no. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:name=".TrellisApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Trellis">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- trellis://<port>/card/<id> — the same links the desktop mints.
                 hypercube:// is accepted too: the scheme name is not settled,
                 and a link pasted into a note outlives a rename. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="trellis"/>
                <data android:scheme="hypercube"/>
            </intent-filter>
        </activity>

        <!-- The unlock gate. excludeFromRecents so it never becomes the task's
             face in the switcher, singleTop so a re-entry doesn't stack gates. -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"/>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"/>

        <activity
            android:name=".BasketActivity"
            android:exported="false"/>

        <activity
            android:name=".SearchActivity"
            android:exported="false"/>

        <activity
            android:name=".AgendaActivity"
            android:exported="false"/>

        <activity
            android:name=".KanbanActivity"
            android:exported="false"/>

        <activity
            android:name=".TagsActivity"
            android:exported="false"/>

        <activity
            android:name=".BacklinksActivity"
            android:exported="false"/>

        <activity
            android:name=".GraphActivity"
            android:exported="false"/>

        <activity
            android:name=".ImageViewerActivity"
            android:theme="@style/Theme.Trellis.Viewer"
            android:exported="false"/>

        <activity
            android:name=".CardReaderActivity"
            android:exported="false"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
    </application>

</manifest>
