<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- 0dp + weight, not match_parent: in a vertical LinearLayout a
         match_parent child takes every remaining pixel, which left the compose
         bar below with nothing and made it invisible even when shown. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Read mode. A wide table pans instead of reflowing, which is why
                 the body keeps its own horizontal scroller. -->
            <HorizontalScrollView
                android:id="@+id/body_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:lineSpacingMultiplier="1.15"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:textIsSelectable="true"/>
            </HorizontalScrollView>

            <!-- Checklist: real checkboxes, because ticking one is the edit a
                 phone is actually good for. -->
            <LinearLayout
                android:id="@+id/checklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="16dp"
                android:visibility="gone"/>

            <!-- Edit mode: the card's own source, never the rendered form. -->
            <EditText
                android:id="@+id/editor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="8"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                android:importantForAutofill="no"
                android:hint="@string/card_body_hint"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <!-- Channel compose bar. Hidden unless this card is a channel.
         A channel exists so the operator can talk to an agent from the sofa,
         and before this the only way to say anything from the phone was to
         open the whole conversation in the editor and hand-append to the
         bottom of it, below every header, without disturbing them. -->
    <LinearLayout
        android:id="@+id/compose_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="12dp"
        android:paddingEnd="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="?attr/colorSurfaceContainer"
        android:visibility="gone">

        <EditText
            android:id="@+id/compose_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="6"
            android:inputType="textMultiLine|textCapSentences"
            android:importantForAutofill="no"
            android:hint="@string/channel_compose_hint"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface"/>

        <ImageButton
            android:id="@+id/compose_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_send"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/channel_send"
            app:tint="?attr/colorPrimary"/>
    </LinearLayout>
</LinearLayout>
